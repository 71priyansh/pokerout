# Copy to .env for local builds; on Vercel add these under Project → Settings → Environment Variables.
# Both values come from Supabase → Project Settings → API. The anon key is PUBLIC by design.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key...

# Optional: your final domain, used for link previews (WhatsApp / iMessage cards).
SITE_URL=https://pokerout.app

# NEVER add the service_role key to this app.
